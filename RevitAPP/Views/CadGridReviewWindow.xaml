<Window x:Class="RevitAPP.Views.CadGridReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước lưới trục từ CAD"
        Width="1100" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitAPP;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Large}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="{Binding SourceLabel}"
                   Style="{DynamicResource TextBlock.Label}"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="PreviewScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Cursor="SizeAll">
                    <Canvas x:Name="PreviewCanvas"
                            Background="{DynamicResource Brush.Surface}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"/>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8">
                    <Button Content="＋" Width="34" Height="28"
                            ToolTip="Phóng to"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding ZoomInCommand}"/>
                    <Button Content="－" Width="34" Height="28" Margin="4,0,0,0"
                            ToolTip="Thu nhỏ"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding ZoomOutCommand}"/>
                    <Button Content="Vừa màn hình" Height="28" Margin="4,0,0,0"
                            Padding="10,0"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding ZoomToFitCommand}"/>
                </StackPanel>

                <TextBlock Text="Lăn chuột để phóng to/thu nhỏ • Giữ chuột trái để kéo"
                           Style="{DynamicResource TextBlock.Label}"
                           Opacity="0.7"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Button Content="Select From Cad"
                        HorizontalAlignment="Stretch"
                        Padding="0,6"
                        Style="{DynamicResource Button.Secondary}"
                        ToolTip="Quét chọn lại trong AutoCAD đang mở"
                        Command="{Binding ReselectCommand}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Chọn tất cả"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding SelectAllCommand}"/>
                    <Button Content="Bỏ chọn" Margin="6,0,0,0"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding SelectNoneCommand}"/>
                    <Button Content="Chỉ trục chính" Margin="6,0,0,0"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding SelectFamiliesOnlyCommand}"/>
                </StackPanel>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Axes}"
                      Style="{DynamicResource DataGrid.Standard}"
                      CellStyle="{DynamicResource DataGridCell.Standard}"
                      ColumnHeaderStyle="{DynamicResource DataGridHeader.Standard}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Tạo"
                                            Width="46"
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Tên"
                                        Width="70"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Loại"
                                        Width="80"
                                        IsReadOnly="True"
                                        Binding="{Binding KindLabel}"/>
                    <DataGridTextColumn Header="Góc"
                                        Width="62"
                                        IsReadOnly="True"
                                        Binding="{Binding AngleLabel}"/>
                    <DataGridTextColumn Header="Dài"
                                        Width="*"
                                        IsReadOnly="True"
                                        Binding="{Binding LengthLabel}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding SummaryLabel}"
                       Style="{DynamicResource TextBlock.Label}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ"
                        MinWidth="96"
                        Style="{DynamicResource Button.Secondary}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Tạo Grid"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Style="{DynamicResource Button.Primary}"
                        Command="{Binding AcceptCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
