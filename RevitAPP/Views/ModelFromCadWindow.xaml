<Window x:Class="RevitAPP.Views.ModelFromCadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model From CAD"
        Width="1220" Height="780"
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitAPP;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Large}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SourceLabel}"
                   Style="{DynamicResource TextBlock.Label}" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1" TabStripPlacement="Left"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItem.Navigation}"/>
            </TabControl.Resources>

            <TabItem Header="▦  Create Grid">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Select From CAD" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Style="{DynamicResource Button.Secondary}" Command="{Binding ReselectCommand}"/>

                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="8,6">
                                <Button Content="+" Width="34" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding ZoomInCommand}"/>
                                <Button Content="-" Width="34" Margin="4,0,0,0"
                                        Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomOutCommand}"/>
                                <Button Content="Vừa màn hình" Margin="4,0,0,0"
                                        Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomToFitCommand}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" x:Name="GridPreviewScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" Cursor="SizeAll">
                                <Canvas x:Name="GridPreviewCanvas" Background="{DynamicResource Brush.Surface}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rotation:" Width="74" VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Width="82" Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>
                                <TextBlock Text="độ" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlock.Label}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Chọn tất cả" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectAllGridsCommand}"/>
                                <Button Content="Bỏ chọn" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectNoGridsCommand}"/>
                                <Button Content="Chỉ trục chính" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectGridFamiliesCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding GridAxes}"
                                  Style="{DynamicResource DataGrid.Standard}"
                                  CellStyle="{DynamicResource DataGridCell.Standard}"
                                  ColumnHeaderStyle="{DynamicResource DataGridHeader.Standard}"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Tạo" Width="48"
                                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Tên" Width="75"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Loại" Width="90" IsReadOnly="True" Binding="{Binding KindLabel}"/>
                                <DataGridTextColumn Header="Góc" Width="65" IsReadOnly="True" Binding="{Binding AngleLabel}"/>
                                <DataGridTextColumn Header="Dài" Width="*" IsReadOnly="True" Binding="{Binding LengthLabel}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="▥  Create Column">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Select From CAD" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Style="{DynamicResource Button.Secondary}" Command="{Binding ReselectCommand}"/>

                    <TabControl Grid.Row="1" Grid.Column="0" SelectedIndex="{Binding PreviewModeIndex, Mode=TwoWay}"
                                Style="{DynamicResource TabControl.Standard}">
                        <TabItem Header="2D" Style="{DynamicResource TabItem.Standard}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="8,6">
                                        <CheckBox Content="Lưới" Margin="0,0,8,0"
                                                  Style="{DynamicResource CheckBox.Standard}"
                                                  IsChecked="{Binding ShowGridOverlay}"/>
                                        <CheckBox Content="Nhãn" Margin="0,0,8,0"
                                                  Style="{DynamicResource CheckBox.Standard}"
                                                  IsChecked="{Binding ShowColumnLabels}"/>
                                        <Button Content="+" Width="34" Style="{DynamicResource Button.Secondary}"
                                                Command="{Binding ZoomInCommand}"/>
                                        <Button Content="-" Width="34" Margin="4,0,0,0"
                                                Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomOutCommand}"/>
                                        <Button Content="Vừa màn hình" Margin="4,0,0,0"
                                                Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomToFitCommand}"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" x:Name="ColumnPreviewScroll"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto" Cursor="SizeAll">
                                        <Canvas x:Name="ColumnPreviewCanvas" Background="{DynamicResource Brush.Surface}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="3D" Style="{DynamicResource TabItem.Standard}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Grid x:Name="ColumnPreview3DHost" Background="Transparent" Cursor="SizeAll">
                                    <Viewport3D x:Name="ColumnPreview3D" ClipToBounds="True" IsHitTestVisible="False"/>
                                    <TextBlock Text="3D preview — kéo chuột trái để xoay, lăn chuột để zoom"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                               Style="{DynamicResource TextBlock.Label}"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Padding="{DynamicResource Spacing.Large}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Family:" Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                          ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"
                                          DisplayMemberPath="DisplayName" Style="{DynamicResource ComboBox.Standard}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                          ItemsSource="{Binding WidthParameters}" SelectedItem="{Binding SelectedWidthParameter}"
                                          Style="{DynamicResource ComboBox.Standard}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Height:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                          ItemsSource="{Binding HeightParameters}" SelectedItem="{Binding SelectedHeightParameter}"
                                          Style="{DynamicResource ComboBox.Standard}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Base Level:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                          ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedBaseLevel}"
                                          DisplayMemberPath="Name" Style="{DynamicResource ComboBox.Standard}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Top Level:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                          ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedTopLevel}"
                                          DisplayMemberPath="Name" Style="{DynamicResource ComboBox.Standard}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Base Offset:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                         Text="{Binding BaseOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Top Offset:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Grid.Row="3" Grid.Column="3" Margin="0,8,0,0"
                                         Text="{Binding TopOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Rotation:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,8,0"
                                         Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Text="độ — cộng vào góc CAD" Style="{DynamicResource TextBlock.Label}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Chọn tất cả" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectAllColumnsCommand}"/>
                                <Button Content="Bỏ chọn" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectNoColumnsCommand}"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}"
                                      SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                      Style="{DynamicResource DataGrid.Standard}"
                                      CellStyle="{DynamicResource DataGridCell.Standard}"
                                      ColumnHeaderStyle="{DynamicResource DataGridHeader.Standard}"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Tạo" Width="48"
                                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Width" Width="68" IsReadOnly="True" Binding="{Binding WidthLabel}"/>
                                    <DataGridTextColumn Header="Height" Width="68" IsReadOnly="True" Binding="{Binding HeightLabel}"/>
                                    <DataGridTextColumn Header="No." Width="48" IsReadOnly="True" Binding="{Binding Number}"/>
                                    <DataGridTextColumn Header="Góc" Width="58" IsReadOnly="True" Binding="{Binding AngleLabel}"/>
                                    <DataGridTextColumn Header="Trạng thái" Width="92" IsReadOnly="True" Binding="{Binding Status}"/>
                                    <DataGridTextColumn Header="Text / Block" Width="*" IsReadOnly="True" Binding="{Binding Text}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="▰  Create Beam">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="1. Select Grid Axes" Style="{DynamicResource Button.Secondary}"
                                Command="{Binding ReselectCommand}"/>
                        <Button Content="2. Select Beam Lines" Margin="8,0,0,0"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding SelectBeamLinesCommand}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="400"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*" MinWidth="390"/>
                        </Grid.ColumnDefinitions>

                        <TabControl Grid.Column="0" SelectedIndex="{Binding BeamPreviewModeIndex, Mode=TwoWay}"
                                    Style="{DynamicResource TabControl.Standard}">
                            <TabItem Header="2D" Style="{DynamicResource TabItem.Standard}">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <WrapPanel Grid.Row="0" HorizontalAlignment="Right" Margin="8,6">
                                            <CheckBox Content="Lưới" Margin="0,0,8,0"
                                                      Style="{DynamicResource CheckBox.Standard}"
                                                      IsChecked="{Binding ShowBeamGridOverlay}"/>
                                            <CheckBox Content="Nhãn" Margin="0,0,8,0"
                                                      Style="{DynamicResource CheckBox.Standard}"
                                                      IsChecked="{Binding ShowBeamLabels}"/>
                                            <Button Content="+" Width="34" Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ZoomInCommand}"/>
                                            <Button Content="-" Width="34" Margin="4,0,0,0"
                                                    Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ZoomOutCommand}"/>
                                            <Button Content="Vừa màn hình" Margin="4,0,0,0"
                                                    Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ZoomToFitCommand}"/>
                                        </WrapPanel>
                                        <ScrollViewer Grid.Row="1" x:Name="BeamPreviewScroll"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto" Cursor="SizeAll">
                                            <Canvas x:Name="BeamPreviewCanvas"
                                                    Background="{DynamicResource Brush.Surface}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </TabItem>
                            <TabItem Header="3D" Style="{DynamicResource TabItem.Standard}">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Grid x:Name="BeamPreview3DHost" Background="Transparent" Cursor="SizeAll">
                                        <Viewport3D x:Name="BeamPreview3D" ClipToBounds="True" IsHitTestVisible="False"/>
                                        <Button Content="Vừa màn hình" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Margin="8"
                                                Style="{DynamicResource Button.Secondary}"
                                                Command="{Binding ZoomToFitCommand}"/>
                                        <TextBlock Text="3D preview — kéo chuột trái để xoay, lăn chuột để zoom"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource Brush.Border}"/>

                        <Grid Grid.Column="2" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Padding="{DynamicResource Spacing.Medium}" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Family:"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                  ItemsSource="{Binding BeamFamilies}"
                                                  SelectedItem="{Binding SelectedBeamFamily}"
                                                  DisplayMemberPath="DisplayName"
                                                  Style="{DynamicResource ComboBox.Standard}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                                  ItemsSource="{Binding BeamWidthParameters}"
                                                  SelectedItem="{Binding SelectedBeamWidthParameter}"
                                                  Style="{DynamicResource ComboBox.Standard}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Height:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                                  ItemsSource="{Binding BeamHeightParameters}"
                                                  SelectedItem="{Binding SelectedBeamHeightParameter}"
                                                  Style="{DynamicResource ComboBox.Standard}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Level:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                                  ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedBeamLevel}"
                                                  DisplayMemberPath="Name" Style="{DynamicResource ComboBox.Standard}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Z Offset:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding BeamZOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Line:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                                 Text="{Binding MinimumBeamLineText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Gap Join:" Margin="0,8,0,0"
                                                   ToolTip="Nối các đoạn cùng phương/cùng đường có khe hở không vượt giá trị này (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="3" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding GapJoinText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Text Search:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,8,0"
                                                 Text="{Binding TextSearchDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Gap Max:" Margin="0,8,0,0"
                                                   ToolTip="Khe lớn hơn giá trị này sẽ tách thành hai dầm riêng, dù cùng trục và cùng tiết diện. Để trống nghĩa là không giới hạn (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="4" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding MaximumRunGapText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                                Content="Apply / Re-analyze"
                                                Style="{DynamicResource Button.Secondary}"
                                                Command="{Binding ApplyBeamAnalysisCommand}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                                <Button Content="Chọn tất cả" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectAllBeamsCommand}"/>
                                <Button Content="Bỏ chọn" Margin="6,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectNoBeamsCommand}"/>
                                <Button Content="Reset CAD/Text" Margin="6,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding ResetSelectedBeamSectionCommand}"/>
                            </WrapPanel>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Beams}"
                                      SelectedItem="{Binding SelectedBeam, Mode=TwoWay}"
                                      Style="{DynamicResource DataGrid.Standard}"
                                      CellStyle="{DynamicResource DataGridCell.Standard}"
                                      ColumnHeaderStyle="{DynamicResource DataGridHeader.Standard}"
                                      HorizontalScrollBarVisibility="Auto" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Tạo" Width="44"
                                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="b CAD" Width="58" IsReadOnly="True"
                                                        Binding="{Binding GeometryWidthLabel}"/>
                                    <DataGridTextColumn Header="b Text" Width="58" IsReadOnly="True"
                                                        Binding="{Binding TextWidthLabel}"/>
                                    <DataGridTextColumn Header="h Text" Width="58" IsReadOnly="True"
                                                        Binding="{Binding TextHeightLabel}"/>
                                    <DataGridTextColumn Header="b Tạo" Width="62"
                                                        Binding="{Binding EffectiveWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="h Tạo" Width="62"
                                                        Binding="{Binding EffectiveHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Mark" Width="70"
                                                        Binding="{Binding Mark, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Trạng thái" Width="112" IsReadOnly="True"
                                                        Binding="{Binding Status}"/>
                                    <DataGridTextColumn Header="Text" Width="*" IsReadOnly="True"
                                                        Binding="{Binding MatchedText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="▨  Create Slab">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="1. Select Grid Axes" Style="{DynamicResource Button.Secondary}"
                                Command="{Binding ReselectCommand}"/>
                        <Button Content="2. Select Slab Lines" Margin="8,0,0,0"
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding SelectSlabLinesCommand}"/>
                        <Button Content="3. Select Ô Trống" Margin="8,0,0,0"
                                ToolTip="Quét chọn đường bao của các ô không đổ sàn (ô thang, hộp kỹ thuật)."
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding SelectOpeningOutlinesCommand}"/>
                        <Button Content="4. Select Vùng Hatch" Margin="8,0,0,0"
                                ToolTip="Quét chọn các vùng hatch sàn hạ. Bỏ qua nếu muốn dùng hatch đã quét ở bước 2."
                                Style="{DynamicResource Button.Secondary}"
                                Command="{Binding SelectHatchRegionsCommand}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="400"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*" MinWidth="390"/>
                        </Grid.ColumnDefinitions>

                        <TabControl Grid.Column="0" SelectedIndex="{Binding SlabPreviewModeIndex, Mode=TwoWay}"
                                    Style="{DynamicResource TabControl.Standard}">
                            <TabItem Header="2D" Style="{DynamicResource TabItem.Standard}">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <WrapPanel Grid.Row="0" HorizontalAlignment="Right" Margin="8,6">
                                            <CheckBox Content="Lưới" Margin="0,0,8,0"
                                                      Style="{DynamicResource CheckBox.Standard}"
                                                      IsChecked="{Binding ShowSlabGridOverlay}"/>
                                            <CheckBox Content="Nhãn" Margin="0,0,8,0"
                                                      Style="{DynamicResource CheckBox.Standard}"
                                                      IsChecked="{Binding ShowSlabLabels}"/>
                                            <Button Content="+" Width="34" Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ZoomInCommand}"/>
                                            <Button Content="-" Width="34" Margin="4,0,0,0"
                                                    Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ZoomOutCommand}"/>
                                            <Button Content="Vừa màn hình" Margin="4,0,0,0"
                                                    Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ZoomToFitCommand}"/>
                                        </WrapPanel>
                                        <ScrollViewer Grid.Row="1" x:Name="SlabPreviewScroll"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto" Cursor="SizeAll">
                                            <Canvas x:Name="SlabPreviewCanvas"
                                                    Background="{DynamicResource Brush.Surface}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </TabItem>
                            <TabItem Header="3D" Style="{DynamicResource TabItem.Standard}">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Grid x:Name="SlabPreview3DHost" Background="Transparent" Cursor="SizeAll">
                                        <Viewport3D x:Name="SlabPreview3D" ClipToBounds="True" IsHitTestVisible="False"/>
                                        <Button Content="Vừa màn hình" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Margin="8"
                                                Style="{DynamicResource Button.Secondary}"
                                                Command="{Binding ZoomToFitCommand}"/>
                                        <TextBlock Text="3D preview — kéo chuột trái để xoay, lăn chuột để zoom"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource Brush.Border}"/>

                        <Grid Grid.Column="2" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Padding="12" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Floor Type:"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                  ItemsSource="{Binding SlabTypes}"
                                                  SelectedItem="{Binding SelectedSlabType}"
                                                  Style="{DynamicResource ComboBox.Standard}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Level:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                                  ItemsSource="{Binding Levels}"
                                                  SelectedItem="{Binding SelectedSlabLevel}"
                                                  Style="{DynamicResource ComboBox.Standard}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Dày mặc định:" Margin="0,8,0,0"
                                                   ToolTip="Chiều dày dùng cho ô sàn mà bản vẽ không ghi nhãn (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding DefaultSlabThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vertex Snap:" Margin="0,8,0,0"
                                                   ToolTip="Gom các đầu line cách nhau dưới giá trị này về một điểm, để biên hở vẫn khép thành vùng (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                                 Text="{Binding VertexSnapText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Min Line:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding MinimumSlabLineText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Diện tích min:" Margin="0,8,0,0"
                                                   ToolTip="Vùng nhỏ hơn giá trị này được xem là ô kỹ thuật, không phải sàn (m²)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                                 Text="{Binding MinimumSlabAreaText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Bề rộng dầm:" Margin="0,8,0,0"
                                                   ToolTip="Dải hẹp hơn giá trị này giữa hai ô cùng cao độ là vệt dầm và được nối vào tấm sàn (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="3" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding BeamStripWidthText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Offset mặc định:" Margin="0,8,0,0"
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,8,0"
                                                 Text="{Binding DefaultSlabOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Offset sàn hạ:" Margin="0,8,0,0"
                                                   ToolTip="Cao độ hạ dùng cho vùng có hatch mà bản vẽ không ghi cao độ (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="4" Grid.Column="3" Margin="0,8,0,0"
                                                 Text="{Binding LoweredSlabOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Nối hatch:" Margin="0,8,0,0"
                                                   ToolTip="Hai vùng hatch cách nhau dưới giá trị này được nối thành một tấm (do dầm/tường chắn giữa). Xa hơn thì tách riêng — ví dụ có hành lang ở giữa (mm)."
                                                   Style="{DynamicResource TextBlock.Label}"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,8,8,0"
                                                 Text="{Binding HatchJoinDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource TextBox.Standard}"/>

                                        <WrapPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
                                            <CheckBox Content="Ghi đè chiều dày" Margin="0,0,12,0"
                                                      ToolTip="Bỏ qua nhãn chiều dày trong bản vẽ, dùng giá trị mặc định cho mọi tấm."
                                                      Style="{DynamicResource CheckBox.Standard}"
                                                      IsChecked="{Binding OverrideSlabThickness}"/>
                                            <CheckBox Content="Ghi đè cao độ"
                                                      ToolTip="Bỏ qua nhãn cao độ trong bản vẽ, dùng Offset mặc định cho mọi tấm."
                                                      Style="{DynamicResource CheckBox.Standard}"
                                                      IsChecked="{Binding OverrideSlabElevation}"/>
                                            <Button Content="Apply / Re-analyze" Margin="12,0,0,0"
                                                    Style="{DynamicResource Button.Secondary}"
                                                    Command="{Binding ApplySlabAnalysisCommand}"/>
                                        </WrapPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Chọn tất cả" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectAllSlabsCommand}"/>
                                <Button Content="Bỏ chọn" Margin="8,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding ClearSlabSelectionCommand}"/>
                                <Button Content="Reset CAD/Text" Margin="8,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding ResetSlabsToDetectedCommand}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Slabs}"
                                      SelectedItem="{Binding SelectedSlab}"
                                      Style="{DynamicResource DataGrid.Standard}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Tạo" Width="44"
                                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Ô" Width="40" IsReadOnly="True"
                                                        Binding="{Binding CellCount}"/>
                                    <DataGridTextColumn Header="Diện tích" Width="72" IsReadOnly="True"
                                                        Binding="{Binding AreaLabel}"/>
                                    <DataGridTextColumn Header="h CAD" Width="56" IsReadOnly="True"
                                                        Binding="{Binding DetectedThicknessLabel}"/>
                                    <DataGridTextColumn Header="h Tạo" Width="58"
                                                        Binding="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Cao độ CAD" Width="80" IsReadOnly="True"
                                                        Binding="{Binding DetectedElevationLabel}"/>
                                    <DataGridTextColumn Header="Offset" Width="62"
                                                        Binding="{Binding OffsetMm, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Lỗ" Width="36" IsReadOnly="True"
                                                        Binding="{Binding HoleCount}"/>
                                    <DataGridTextColumn Header="Trạng thái" Width="106" IsReadOnly="True"
                                                        Binding="{Binding Status}"/>
                                    <DataGridTextColumn Header="Text" Width="*" IsReadOnly="True"
                                                        Binding="{Binding MatchedText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding SummaryLabel}" Style="{DynamicResource TextBlock.Label}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" Style="{DynamicResource Button.Secondary}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{Binding CreateButtonText}" Margin="8,0,0,0"
                        Style="{DynamicResource Button.Primary}" Command="{Binding AcceptCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
