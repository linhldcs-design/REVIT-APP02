<Window x:Class="RevitAPP.Views.ModelFromCadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model From CAD"
        Width="1220" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitAPP;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Large}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SourceLabel}"
                   Style="{DynamicResource TextBlock.Label}" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1" TabStripPlacement="Left"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItem.Navigation}"/>
            </TabControl.Resources>

            <TabItem Header="▦  Create Grid">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Select From CAD" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Style="{DynamicResource Button.Secondary}" Command="{Binding ReselectCommand}"/>

                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="8,6">
                                <Button Content="+" Width="34" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding ZoomInCommand}"/>
                                <Button Content="-" Width="34" Margin="4,0,0,0"
                                        Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomOutCommand}"/>
                                <Button Content="Vừa màn hình" Margin="4,0,0,0"
                                        Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomToFitCommand}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" x:Name="GridPreviewScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" Cursor="SizeAll">
                                <Canvas x:Name="GridPreviewCanvas" Background="{DynamicResource Brush.Surface}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rotation:" Width="74" VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Width="82" Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>
                                <TextBlock Text="độ" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlock.Label}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Chọn tất cả" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectAllGridsCommand}"/>
                                <Button Content="Bỏ chọn" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectNoGridsCommand}"/>
                                <Button Content="Chỉ trục chính" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectGridFamiliesCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding GridAxes}"
                                  Style="{DynamicResource DataGrid.Standard}"
                                  CellStyle="{DynamicResource DataGridCell.Standard}"
                                  ColumnHeaderStyle="{DynamicResource DataGridHeader.Standard}"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Tạo" Width="48"
                                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Tên" Width="75"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Loại" Width="90" IsReadOnly="True" Binding="{Binding KindLabel}"/>
                                <DataGridTextColumn Header="Góc" Width="65" IsReadOnly="True" Binding="{Binding AngleLabel}"/>
                                <DataGridTextColumn Header="Dài" Width="*" IsReadOnly="True" Binding="{Binding LengthLabel}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="▥  Create Column">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Select From CAD" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Style="{DynamicResource Button.Secondary}" Command="{Binding ReselectCommand}"/>

                    <TabControl Grid.Row="1" Grid.Column="0" SelectedIndex="{Binding PreviewModeIndex, Mode=TwoWay}"
                                Style="{DynamicResource TabControl.Standard}">
                        <TabItem Header="2D" Style="{DynamicResource TabItem.Standard}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="8,6">
                                        <CheckBox Content="Lưới" Margin="0,0,8,0"
                                                  Style="{DynamicResource CheckBox.Standard}"
                                                  IsChecked="{Binding ShowGridOverlay}"/>
                                        <CheckBox Content="Nhãn" Margin="0,0,8,0"
                                                  Style="{DynamicResource CheckBox.Standard}"
                                                  IsChecked="{Binding ShowColumnLabels}"/>
                                        <Button Content="+" Width="34" Style="{DynamicResource Button.Secondary}"
                                                Command="{Binding ZoomInCommand}"/>
                                        <Button Content="-" Width="34" Margin="4,0,0,0"
                                                Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomOutCommand}"/>
                                        <Button Content="Vừa màn hình" Margin="4,0,0,0"
                                                Style="{DynamicResource Button.Secondary}" Command="{Binding ZoomToFitCommand}"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" x:Name="ColumnPreviewScroll"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto" Cursor="SizeAll">
                                        <Canvas x:Name="ColumnPreviewCanvas" Background="{DynamicResource Brush.Surface}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="3D" Style="{DynamicResource TabItem.Standard}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Grid x:Name="ColumnPreview3DHost" Background="Transparent" Cursor="SizeAll">
                                    <Viewport3D x:Name="ColumnPreview3D" ClipToBounds="True" IsHitTestVisible="False"/>
                                    <TextBlock Text="3D preview — kéo chuột trái để xoay, lăn chuột để zoom"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                               Style="{DynamicResource TextBlock.Label}"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Padding="{DynamicResource Spacing.Large}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Family:" Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                          ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"
                                          DisplayMemberPath="DisplayName" Style="{DynamicResource ComboBox.Standard}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                          ItemsSource="{Binding WidthParameters}" SelectedItem="{Binding SelectedWidthParameter}"
                                          Style="{DynamicResource ComboBox.Standard}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Height:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                          ItemsSource="{Binding HeightParameters}" SelectedItem="{Binding SelectedHeightParameter}"
                                          Style="{DynamicResource ComboBox.Standard}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Base Level:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,8,0"
                                          ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedBaseLevel}"
                                          DisplayMemberPath="Name" Style="{DynamicResource ComboBox.Standard}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Top Level:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,8,0,0"
                                          ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedTopLevel}"
                                          DisplayMemberPath="Name" Style="{DynamicResource ComboBox.Standard}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Base Offset:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,8,0"
                                         Text="{Binding BaseOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Top Offset:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Grid.Row="3" Grid.Column="3" Margin="0,8,0,0"
                                         Text="{Binding TopOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Rotation:" Margin="0,8,0,0"
                                           Style="{DynamicResource TextBlock.Label}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,8,0"
                                         Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBox.Standard}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Text="độ — cộng vào góc CAD" Style="{DynamicResource TextBlock.Label}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Chọn tất cả" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectAllColumnsCommand}"/>
                                <Button Content="Bỏ chọn" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                        Command="{Binding SelectNoColumnsCommand}"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}"
                                      SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                      Style="{DynamicResource DataGrid.Standard}"
                                      CellStyle="{DynamicResource DataGridCell.Standard}"
                                      ColumnHeaderStyle="{DynamicResource DataGridHeader.Standard}"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Tạo" Width="48"
                                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Width" Width="68" IsReadOnly="True" Binding="{Binding WidthLabel}"/>
                                    <DataGridTextColumn Header="Height" Width="68" IsReadOnly="True" Binding="{Binding HeightLabel}"/>
                                    <DataGridTextColumn Header="No." Width="48" IsReadOnly="True" Binding="{Binding Number}"/>
                                    <DataGridTextColumn Header="Góc" Width="58" IsReadOnly="True" Binding="{Binding AngleLabel}"/>
                                    <DataGridTextColumn Header="Trạng thái" Width="92" IsReadOnly="True" Binding="{Binding Status}"/>
                                    <DataGridTextColumn Header="Text / Block" Width="*" IsReadOnly="True" Binding="{Binding Text}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding SummaryLabel}" Style="{DynamicResource TextBlock.Label}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" Style="{DynamicResource Button.Secondary}"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{Binding CreateButtonText}" Margin="8,0,0,0"
                        Style="{DynamicResource Button.Primary}" Command="{Binding AcceptCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
