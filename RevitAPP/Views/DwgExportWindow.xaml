<Window x:Class="RevitAPP.Views.DwgExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất Print Set sang DWG Model Space"
        Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Family}"
        FontSize="{DynamicResource Font.Size.Body}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitAPP;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="{DynamicResource Spacing.Large}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="{DynamicResource Spacing.Large}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="XUẤT PRINT SET SANG MỘT DWG MODEL SPACE"
                   Style="{DynamicResource TextBlock.Header}" Margin="0,0,0,16"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource PanelCard}">
                <StackPanel>
                    <TextBlock Text="CẤU HÌNH XUẤT" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Label Content="_Export DWG Setup" Foreground="{DynamicResource Brush.TextSecondary}" Padding="0" Margin="0,8,0,4" Target="{Binding ElementName=SetupCombo}"/>
                    <ComboBox x:Name="SetupCombo" TabIndex="0" Style="{DynamicResource ComboBox.Standard}"
                              ItemsSource="{Binding DwgSetups}" SelectedItem="{Binding SelectedDwgSetup}"/>
                    <Label Content="_Phiên bản DWG" Foreground="{DynamicResource Brush.TextSecondary}" Padding="0" Margin="0,8,0,4" Target="{Binding ElementName=VersionCombo}"/>
                    <ComboBox x:Name="VersionCombo" TabIndex="1" Style="{DynamicResource ComboBox.Standard}"
                              ItemsSource="{Binding DwgVersions}" SelectedItem="{Binding SelectedDwgVersion}"/>
                    <Label Content="_Print Set" Foreground="{DynamicResource Brush.TextSecondary}" Padding="0" Margin="0,8,0,4" Target="{Binding ElementName=PrintSetCombo}"/>
                    <ComboBox x:Name="PrintSetCombo" TabIndex="2" Style="{DynamicResource ComboBox.Standard}"
                              ItemsSource="{Binding PrintSets}" SelectedItem="{Binding SelectedPrintSet}"/>
                    <Label Content="_File DWG duy nhất" Foreground="{DynamicResource Brush.TextSecondary}" Padding="0" Margin="0,8,0,4" Target="{Binding ElementName=OutputText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputText" Grid.Column="0" TabIndex="3" Style="{DynamicResource TextBox.Standard}"
                                 Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" TabIndex="4" Content="_Duyệt..." Margin="8,0,0,0"
                                Style="{DynamicResource Button.Secondary}" Command="{Binding BrowseOutputCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding CoreConsoleStatus}" TextWrapping="Wrap" Margin="0,16,0,0"
                               Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="Chỉ file DWG cuối được bàn giao; staging và xref trung gian được xử lý nội bộ."
                               TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="THỨ TỰ SHEET TỪ TRÁI SANG PHẢI" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" TabIndex="5" ItemsSource="{Binding Sheets}"
                              Style="{DynamicResource DataGrid.Standard}" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="44" Binding="{Binding Ordinal}"/>
                            <DataGridTextColumn Header="Số sheet" Width="90" Binding="{Binding SheetNumber}"/>
                            <DataGridTextColumn Header="Tên sheet" Width="*" Binding="{Binding SheetName}"/>
                            <DataGridTextColumn Header="Tỷ lệ" Width="120" Binding="{Binding ScalesLabel}"/>
                            <DataGridTextColumn Header="Kiểm tra" Width="150" Binding="{Binding StatusMessage}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="View có mẫu số tỷ lệ lớn nhất làm chuẩn. Ví dụ 1:75 và 1:25: 1:75 là chuẩn; 1:25 dùng hệ số hình học 3 và DIMLFAC 1/3."
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button TabIndex="6" Content="_Huỷ" IsCancel="True" Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}"/>
                <Button TabIndex="7" Content="_Xuất DWG" IsDefault="True" Margin="8,0,0,0"
                        Style="{DynamicResource Button.Primary}" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
