<Window x:Class="RevitAPP.Views.BeamLongitudinalDrawingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RevitAPP.Views.Controls"
        Title="Triển khai mặt cắt dọc dầm"
        Width="1320" Height="780" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Family}"
        FontSize="{DynamicResource Font.Size.Body}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitAPP;component/Resources/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PreviewCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="{DynamicResource Spacing.Medium}"/>
            </Style>
            <Style x:Key="PreviewLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="Margin" Value="0,4,0,3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Spacing.Large}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="REVIEW TRỤC VÀ VỊ TRÍ CẮT" FontSize="{DynamicResource Font.Size.Header}" FontWeight="SemiBold"/>
            <Border Grid.Row="1" Margin="0,12,0,12" Style="{DynamicResource PreviewCard}">
                <Grid>
                    <controls:BeamChainPreviewCanvas x:Name="PreviewCanvas" Preview="{Binding Preview}" MinHeight="430"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                        <Button Content="Fit" Command="{x:Static controls:BeamChainPreviewCanvas.FitCommand}"
                                CommandTarget="{Binding ElementName=PreviewCanvas}" Margin="0,0,4,0"
                                Style="{DynamicResource Button.Secondary}"/>
                        <Button Content="−" Command="{x:Static controls:BeamChainPreviewCanvas.ZoomOutCommand}"
                                CommandTarget="{Binding ElementName=PreviewCanvas}" Margin="0,0,4,0"
                                Style="{DynamicResource Button.Secondary}"/>
                        <Button Content="+" Command="{x:Static controls:BeamChainPreviewCanvas.ZoomInCommand}"
                                CommandTarget="{Binding ElementName=PreviewCanvas}"
                                Style="{DynamicResource Button.Secondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                <Button Grid.Column="1" Content="Đảo hướng" Command="{Binding ReverseDirectionCommand}"
                        Margin="8,0" Style="{DynamicResource Button.Secondary}"/>
                <Button Grid.Column="2" Content="Xác nhận preview" Command="{Binding ConfirmPreviewCommand}"
                        Style="{DynamicResource Button.Primary}"/>
            </Grid>
        </Grid>

        <Border Grid.Column="2" Style="{DynamicResource PreviewCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TÀI NGUYÊN BẢN VẼ" FontSize="{DynamicResource Font.Size.Header}" FontWeight="SemiBold"/>
                    <TextBlock Text="Preset" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="SettingName" Style="{DynamicResource ComboBox.Standard}"/>
                    <WrapPanel Margin="0,6,0,6">
                        <Button Content="Nạp" Command="{Binding LoadPresetCommand}" Margin="0,0,4,0" Style="{DynamicResource Button.Secondary}"/>
                        <Button Content="Xóa" Command="{Binding DeletePresetCommand}" Margin="0,0,4,0" Style="{DynamicResource Button.Secondary}"/>
                        <Button Content="Nhập" Command="{Binding ImportPresetsCommand}" Margin="0,0,4,0" Style="{DynamicResource Button.Secondary}"/>
                        <Button Content="Xuất" Command="{Binding ExportPresetsCommand}" Style="{DynamicResource Button.Secondary}"/>
                    </WrapPanel>
                    <TextBlock Text="Dimension Type *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.DimensionTypes}" SelectedItem="{Binding SelectedDimensionType}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Tag thép dọc *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.RebarTagTypes}" SelectedItem="{Binding SelectedLongitudinalTag}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Tag thép đai *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.RebarTagTypes}" SelectedItem="{Binding SelectedStirrupTag}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="MRA thép dọc MC ngang - GỐI *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.MultiRebarAnnotationTypes}" SelectedItem="{Binding SelectedCrossSupportLongitudinalMra}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Tag thép đai MC ngang - GỐI *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.RebarTagTypes}" SelectedItem="{Binding SelectedCrossSupportStirrupTag}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Tag tăng cường lớp 1 MC ngang - GỐI *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.RebarTagTypes}" SelectedItem="{Binding SelectedCrossSupportReinforceL1Tag}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="MRA tăng cường lớp 2 MC ngang - GỐI *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.MultiRebarAnnotationTypes}" SelectedItem="{Binding SelectedCrossSupportReinforceL2Mra}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="MRA thép dọc MC ngang - NHỊP *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.MultiRebarAnnotationTypes}" SelectedItem="{Binding SelectedCrossMidLongitudinalMra}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Tag thép đai MC ngang - NHỊP *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.RebarTagTypes}" SelectedItem="{Binding SelectedCrossMidStirrupTag}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Tag tăng cường lớp 1 MC ngang - NHỊP *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.RebarTagTypes}" SelectedItem="{Binding SelectedCrossMidReinforceL1Tag}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="MRA tăng cường lớp 2 MC ngang - NHỊP *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.MultiRebarAnnotationTypes}" SelectedItem="{Binding SelectedCrossMidReinforceL2Mra}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Detail Component tại cột/gối *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.DetailComponentTypes}" SelectedItem="{Binding SelectedDetailComponent}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Detail Item nét cắt mặt cắt ngang *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.DetailComponentTypes}" SelectedItem="{Binding SelectedCrossBreakLine}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Viewport Type mặt cắt dọc *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Viewport Type mặt cắt ngang *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.ViewportTypes}" SelectedItem="{Binding SelectedCrossViewportType}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Section Type mặt cắt dọc *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.SectionTypes}" SelectedItem="{Binding SelectedLongitudinalSectionType}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Section Type mặt cắt ngang *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.SectionTypes}" SelectedItem="{Binding SelectedCrossSectionType}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Spot Elevation Type *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.SpotElevationTypes}" SelectedItem="{Binding SelectedSpotElevationType}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="View Template mặt cắt dọc" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.ViewTemplates}" SelectedItem="{Binding SelectedLongitudinalViewTemplate}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="View Template mặt cắt ngang" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.ViewTemplates}" SelectedItem="{Binding SelectedCrossViewTemplate}" Style="{DynamicResource ComboBox.Standard}"/>
                    <TextBlock Text="Sheet có sẵn trong project *" Style="{DynamicResource PreviewLabel}"/>
                    <ComboBox ItemsSource="{Binding Resources.ExistingSheets}" SelectedItem="{Binding SelectedTargetSheet}"
                              DisplayMemberPath="Display" Style="{DynamicResource ComboBox.Standard}"/>

                    <TextBlock Text="THÔNG SỐ" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Tỷ lệ" Style="{DynamicResource PreviewLabel}"/><TextBox Text="{Binding ScaleText}" Style="{DynamicResource TextBox.Standard}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Offset annotation (mm)" Style="{DynamicResource PreviewLabel}"/><TextBox Text="{Binding AnnotationOffsetText}" Style="{DynamicResource TextBox.Standard}"/></StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Endpoint tol. (mm)" Style="{DynamicResource PreviewLabel}"/><TextBox Text="{Binding EndpointToleranceText}" Style="{DynamicResource TextBox.Standard}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Alignment tol. (mm)" Style="{DynamicResource PreviewLabel}"/><TextBox Text="{Binding AlignmentToleranceText}" Style="{DynamicResource TextBox.Standard}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Tên preset" Style="{DynamicResource PreviewLabel}"/><TextBox Text="{Binding SettingName}" Style="{DynamicResource TextBox.Standard}"/>
                    <Button Content="Lưu / cập nhật preset" Command="{Binding SavePresetCommand}" Margin="0,8,0,0" Style="{DynamicResource Button.Secondary}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Command="{Binding CancelCommand}" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}"/>
            <Button Content="Tạo bản vẽ" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Style="{DynamicResource Button.Primary}"/>
        </StackPanel>
    </Grid>
</Window>
