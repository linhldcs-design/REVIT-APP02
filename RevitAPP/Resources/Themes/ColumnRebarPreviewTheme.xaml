<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic colors are isolated so preview identity can evolve independently of the app accent. -->
    <Color x:Key="Color.RebarPreview">#FFF03737</Color>
    <Color x:Key="Color.RebarPreview3D">#FFEB2A2A</Color>
    <Color x:Key="Color.RebarLevel">#FF8ECDEE</Color>
    <SolidColorBrush x:Key="Brush.RebarPreview" Color="{DynamicResource Color.RebarPreview}"/>
    <SolidColorBrush x:Key="Brush.RebarLevel" Color="{DynamicResource Color.RebarLevel}"/>
</ResourceDictionary>
